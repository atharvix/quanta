# QUANTA Local Environment Template (copy to .env; never commit .env)
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://quanta:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/quanta_db?sslmode=disable
INTELLIGENCE_URL=http://127.0.0.1:8001
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_SECRET
JWT_ISSUER=quanta-backend
JWT_AUDIENCE=quanta-api
JWT_TTL_MINUTES=60
